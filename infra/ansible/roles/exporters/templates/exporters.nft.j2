# {{ ansible_managed }}
# Seuls le serveur de supervision ({{ monitoring_ip }}), la machine elle-même, les réseaux Docker
# et les pods k3s peuvent lire les collecteurs. Table dédiée : les règles Docker et k3s ne sont pas touchées.
table inet pfe_exporters
delete table inet pfe_exporters

table inet pfe_exporters {
  set allowed_v4 {
    type ipv4_addr
    flags interval
    elements = { {{ ([monitoring_ip] + exporters_allowed_extra) | join(', ') }} }
  }

  chain input {
    type filter hook input priority -10; policy accept;
    tcp dport { {{ port_node_exporter }}, {{ port_cadvisor }}, {{ port_cadvisor_k3s }} } ip saddr @allowed_v4 accept
    tcp dport { {{ port_node_exporter }}, {{ port_cadvisor }}, {{ port_cadvisor_k3s }} } ip6 saddr ::1 accept
    tcp dport { {{ port_node_exporter }}, {{ port_cadvisor }}, {{ port_cadvisor_k3s }} } drop
  }
}
