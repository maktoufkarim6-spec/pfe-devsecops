# {{ ansible_managed }}
# HTTPS en place (https_fermer_ports) : Jenkins n'est plus joignable directement sur le port 8080, seulement par
# https://jenkins.{{ https_domaine }}/ (Traefik, depuis un pod). Restent autorisés : la machine elle-même, les
# réseaux Docker et les pods k3s. Avant la traduction d'adresse de Docker (priorité -100) : le port d'origine est vu.
table inet pfe_https
delete table inet pfe_https

table inet pfe_https {
  set autorises_v4 {
    type ipv4_addr
    flags interval
    elements = { {{ ([app_ip] + exporters_allowed_extra) | join(', ') }} }
  }

  chain prerouting {
    type filter hook prerouting priority -150; policy accept;
    iif "lo" accept
    tcp dport 8080 ip saddr @autorises_v4 accept
    tcp dport 8080 drop
  }
}
