# {{ ansible_managed }}
# Adresses HTTPS de la plateforme sur Traefik (k3s) : pour chacune, un Ingress HTTPS avec son certificat Let's Encrypt
# (cert-manager, secret <nom>-certificat) et un Ingress HTTP qui redirige vers HTTPS, comme le chart des applications
# (plateforme/chart/templates/ingress.yaml). La validation Let's Encrypt (/.well-known/acme-challenge/...) passe en
# HTTP : cert-manager crée pour elle une règle plus précise, que Traefik choisit en priorité.
{% set entrees = [] %}
{% if https_app | bool %}
{%   set _ = entrees.append({'nom': app_name, 'ns': app_namespace, 'hote': app_domaine, 'chemins': https_chemins_app}) %}
{% endif %}
{% if https_plateforme | bool %}
{%   set _ = entrees.append({'nom': 'jenkins', 'ns': 'plateforme', 'hote': 'jenkins.' ~ https_domaine,
                             'chemins': [{'path': '/', 'pathType': 'Prefix',
                                          'backend': {'service': {'name': 'jenkins', 'port': {'number': 8080}}}}]}) %}
{%   set _ = entrees.append({'nom': 'argocd', 'ns': 'argocd', 'hote': 'argocd.' ~ https_domaine,
                             'chemins': [{'path': '/', 'pathType': 'Prefix',
                                          'backend': {'service': {'name': 'pfe-argocd-https', 'port': {'number': 443}}}}]}) %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: plateforme
  labels:
    app.kubernetes.io/managed-by: plateforme-pfe
---
# Jenkins tourne hors de k3s (conteneur Docker, port 8080 du nœud de contrôle) : service sans sélecteur, dont
# l'unique adresse est celle du nœud
apiVersion: v1
kind: Service
metadata:
  name: jenkins
  namespace: plateforme
  labels:
    app.kubernetes.io/managed-by: plateforme-pfe
spec:
  ports:
    - name: http
      port: 8080
      targetPort: 8080
      protocol: TCP
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: jenkins-noeud
  namespace: plateforme
  labels:
    kubernetes.io/service-name: jenkins
    endpointslice.kubernetes.io/managed-by: plateforme-pfe
    app.kubernetes.io/managed-by: plateforme-pfe
addressType: IPv4
ports:
  - name: http
    port: 8080
    protocol: TCP
endpoints:
  - addresses: [{{ app_ip | to_json }}]
---
# Argo CD sert lui-même du HTTPS (certificat auto-signé) : Traefik le joint en HTTPS sans vérifier ce certificat
# interne. Service distinct de argocd-server : l'installation d'Argo CD n'est pas modifiée.
apiVersion: v1
kind: Service
metadata:
  name: pfe-argocd-https
  namespace: argocd
  labels:
    app.kubernetes.io/managed-by: plateforme-pfe
  annotations:
    traefik.ingress.kubernetes.io/service.serversscheme: https
    traefik.ingress.kubernetes.io/service.serverstransport: argocd-pfe-argocd-interne@kubernetescrd
spec:
  selector:
    app.kubernetes.io/name: argocd-server
  ports:
    - name: https
      port: 443
      targetPort: 8080
      protocol: TCP
---
apiVersion: traefik.io/v1alpha1
kind: ServersTransport
metadata:
  name: pfe-argocd-interne
  namespace: argocd
  labels:
    app.kubernetes.io/managed-by: plateforme-pfe
spec:
  insecureSkipVerify: true
{% endif %}
{% for ns in entrees | map(attribute='ns') | unique %}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: pfe-vers-https
  namespace: {{ ns }}
  labels:
    app.kubernetes.io/managed-by: plateforme-pfe
spec:
  redirectScheme:
    scheme: https
    permanent: true
{% endfor %}
{% for e in entrees %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ e.nom }}-https
  namespace: {{ e.ns }}
  labels:
    app.kubernetes.io/managed-by: plateforme-pfe
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    cert-manager.io/cluster-issuer: {{ https_emetteur }}
spec:
  tls:
    - hosts: [{{ e.hote | to_json }}]
      secretName: {{ e.nom }}-certificat
  rules:
    - host: {{ e.hote | to_json }}
      http:
        paths: {{ e.chemins | to_json }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ e.nom }}-http
  namespace: {{ e.ns }}
  labels:
    app.kubernetes.io/managed-by: plateforme-pfe
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
    traefik.ingress.kubernetes.io/router.middlewares: {{ e.ns }}-pfe-vers-https@kubernetescrd
spec:
  rules:
    - host: {{ e.hote | to_json }}
      http:
        paths: {{ e.chemins | to_json }}
{% endfor %}
