{
  "uid": "pfe-accueil",
  "title": "PFE - Accueil",
  "tags": [
    "pfe"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Détails techniques",
      "type": "link",
      "url": "/d/pfe-details",
      "icon": "dashboard"
    },
    {
      "title": "Jenkins",
      "type": "link",
      "url": "http://__APP_IP__:8080/",
      "icon": "external link",
      "targetBlank": true
    },
    {
      "title": "Argo CD",
      "type": "link",
      "url": "https://__APP_IP__:32252/",
      "icon": "external link",
      "targetBlank": true
    },
    {
      "title": "Dépôt GitHub",
      "type": "link",
      "url": "__REPO_WEB__",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "",
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efx9ykc7u57nkf"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "efx9ykc7u57nkf"
          },
          "expr": "count(ALERTS{alertstate=\"firing\",alertname!=\"ActionAutomatique\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "description": "Alertes actives sur tout le parc. Leur liste est en haut de la page « Détails techniques ».",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: point(s) à regarder",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Tout fonctionne",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000000.0,
                "result": {
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Voir les alertes",
              "url": "/d/pfe-details"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "text",
      "title": "",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### 🚀 Déployer une application\nBouton **Déployer** sur sa ligne ci-dessous : son code (dernière version de son dépôt GitHub) est testé, contrôlé (SonarQube, Trivy) puis mis en ligne, en 10 minutes environ. Si un contrôle échoue, rien ne change."
      }
    },
    {
      "type": "text",
      "title": "",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### [📦 Ajouter une application](__JENKINS_APPS_URL__)\nSon nom et l'adresse de son dépôt Git : la plateforme la construit, la contrôle, la met en ligne puis la surveille."
      }
    },
    {
      "type": "table",
      "title": "Applications",
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efx9ykc7u57nkf"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "efx9ykc7u57nkf"
          },
          "expr": "max by (application, instance) (probe_success{job=\"applications\"}) or label_replace(max by (instance) (probe_success{job=\"services\",service=\"Application\"}), \"application\", \"__APP_NAME__\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "efx9ykc7u57nkf"
          },
          "expr": "max by (application, version) (pfe_deploiement_version{version=~\".+-[0-9a-f]{7}\"}) or on (application) max by (application, version) (pfe_deploiement_version)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "efx9ykc7u57nkf"
          },
          "expr": "max by (application, resultat) (pfe_ci_dernier_build)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "efx9ykc7u57nkf"
          },
          "expr": "max by (application) (aiops_anomaly_active * on (node) group_left (application) aiops_target_info{kind=\"application\"}) or label_replace((max(aiops_anomaly_active{node=\"__CTL_NODE__\"}) * max(aiops_top_feature{node=\"__CTL_NODE__\",feature=~\"cpu_server|ram_server_mb|ram_postgres_mb|app_containers\"})) or vector(0), \"application\", \"__APP_NAME__\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "efx9ykc7u57nkf"
          },
          "expr": "label_replace(max by (application) (probe_success{job=\"applications\"}), \"deployer\", \"__JENKINS_APPS_PARAM_URL__$1\", \"application\", \"(.+)\") or label_replace(label_replace(max(probe_success{job=\"services\",service=\"Application\"}), \"application\", \"__APP_NAME__\", \"\", \"\"), \"deployer\", \"__JENKINS_JOB_URL__\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "État : adresse web testée toutes les 15 s. Version en ligne : celle qui tourne vraiment. Dernier build : résultat du dernier passage dans Jenkins. IA : comportement anormal détecté. Cliquer sur un nom pour ouvrir l'application ; sur « Déployer » pour la reconstruire et la remettre en ligne depuis son dépôt (formulaire Jenkins prérempli, puis Build).",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "application",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "application",
                "Value #A",
                "version",
                "resultat",
                "Value #D",
                "Value #E",
                "instance",
                "deployer"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "application": 0,
              "Value #A": 1,
              "version": 2,
              "resultat": 3,
              "Value #D": 4,
              "Value #E": 5,
              "instance": 6,
              "deployer": 7
            },
            "renameByName": {
              "application": "Application",
              "Value #A": "État",
              "version": "Version en ligne",
              "resultat": "Dernier build",
              "Value #D": "IA",
              "Value #E": "Action",
              "instance": "instance",
              "deployer": "deployer"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "links": [],
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "État"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "en ligne",
                        "color": "green"
                      },
                      "0": {
                        "text": "HORS LIGNE",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dernier build"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SUCCESS": {
                        "text": "réussi",
                        "color": "green"
                      },
                      "UNSTABLE": {
                        "text": "instable",
                        "color": "orange"
                      },
                      "FAILURE": {
                        "text": "ÉCHEC",
                        "color": "red"
                      },
                      "ABORTED": {
                        "text": "interrompu",
                        "color": "text"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IA"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "normal",
                        "color": "green"
                      },
                      "1": {
                        "text": "anomalie",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "instance"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "deployer"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Action"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": -1,
                      "to": 2,
                      "result": {
                        "text": "🚀 Déployer",
                        "color": "blue"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Déployer ${__data.fields.Application}",
                    "url": "${__data.fields.deployer}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Application"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Ouvrir ${__value.text}",
                    "url": "${__data.fields.instance}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      }
    },
