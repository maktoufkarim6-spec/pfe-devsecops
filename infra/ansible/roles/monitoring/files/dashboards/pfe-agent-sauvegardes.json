      "datasource": {
        "type": "prometheus",
        "uid": "efx9ykc7u57nkf"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "efx9ykc7u57nkf"
          },
          "expr": "max(pfe_agent_mode) + 2 * max(pfe_agent_suspended) or vector(-1)"
        }
      ],
      "description": "Conseil : simule et journalise. Actif : exécute. Suspendu : arrêt après des échecs répétés (python -m agent reprendre).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "ARRÊTÉ",
                  "color": "red"
                },
                "0": {
                  "text": "CONSEIL",
                  "color": "blue"
                },
                "1": {
                  "text": "ACTIF",
                  "color": "green"
                },
                "2": {
                  "text": "SUSPENDU",
                  "color": "red"
                },
                "3": {
                  "text": "SUSPENDU",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
