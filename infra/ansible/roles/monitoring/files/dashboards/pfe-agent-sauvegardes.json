        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "node": "Nœud",
              "action": "Action",
              "outcome": "Résultat",
              "Value": "Heure"
            },
            "indexByName": {
              "Value": 0,
              "node": 1,
              "action": 2,
              "outcome": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Heure",
