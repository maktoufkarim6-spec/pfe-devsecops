# {{ ansible_managed }}
route:
  receiver: {{ 'email' if alert_email_to else 'aucun' }}
  group_by: [alertname, node]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
{% if alert_email_to %}
  routes:
    - matchers: ['severity="info"']
      receiver: aucun
{% endif %}

# Une alerte « nœud injoignable » masque les anomalies du même nœud qui en découlent
inhibit_rules:
  - source_matchers: ['alertname="NoeudInjoignable"']
    target_matchers: ['severity=~"warning|critical"']
    equal: [node]

receivers:
  - name: aucun
{% if alert_email_to %}
  - name: email
    email_configs:
      - to: "{{ alert_email_to }}"
        from: "{{ alert_email_from or alert_email_to }}"
        smarthost: "{{ smtp_smarthost }}"
        auth_username: "{{ alert_email_from or alert_email_to }}"
        auth_password_file: /etc/alertmanager/secrets/smtp-password
        require_tls: true
        send_resolved: true
        headers:
          Subject: '{% raw %}[PFE] {{ .Status | toUpper }} {{ .CommonLabels.alertname }} sur {{ .CommonLabels.node }}{% endraw %}'
{% endif %}
