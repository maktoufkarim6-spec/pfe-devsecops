# {{ ansible_managed }}
route:
  receiver: {{ 'email' if alert_email_to else 'aucun' }}
  group_by: [alertname, node]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Toutes les alertes sont aussi transmises à l'agent de remédiation, qui décide seul s'il peut agir.
    # Rappel toutes les 30 min tant qu'elles durent : l'agent retente après sa pause, puis escalade.
    - receiver: agent
      continue: true
      group_by: [alertname, node, job]
      group_wait: 10s
      group_interval: 1m
      repeat_interval: 30m
{% if alert_email_to %}
    - matchers: ['severity="info"']
      receiver: aucun
{% endif %}

# Une alerte « nœud injoignable » masque les anomalies du même nœud qui en découlent
inhibit_rules:
  - source_matchers: ['alertname="NoeudInjoignable"']
    target_matchers: ['severity=~"warning|critical"']
    equal: [node]

receivers:
  - name: aucun
  - name: agent
    webhook_configs:
      - url: http://mon-remediation:9095/alert
        send_resolved: false
        max_alerts: 20
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/secrets/agent-webhook-token
{% if alert_email_to %}
  - name: email
    email_configs:
      - to: "{{ alert_email_to }}"
        from: "{{ alert_email_from or alert_email_to }}"
        smarthost: "{{ smtp_smarthost }}"
        auth_username: "{{ alert_email_from or alert_email_to }}"
        auth_password_file: /etc/alertmanager/secrets/smtp-password
        require_tls: true
        send_resolved: true
        headers:
          Subject: '{% raw %}[PFE] {{ .Status | toUpper }} {{ .CommonLabels.alertname }} sur {{ .CommonLabels.node }}{% endraw %}'
{% endif %}
