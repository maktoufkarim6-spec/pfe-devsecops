# {{ ansible_managed }}
# Chaque collecteur porte l'étiquette node : Grafana et le moteur AIOps filtrent par nœud.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alert-rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["mon-alertmanager:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: aiops-engine
    static_configs:
      - targets: ["mon-aiops-engine:8000"]

  - job_name: remediation-agent
    static_configs:
      - targets: ["mon-remediation:9095"]

  # État des services du projet (page d'accueil) : chaque adresse est testée par blackbox-exporter
  - job_name: services
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
{% for s in services_web %}
      - targets: ["{{ s.url }}"]
        labels:
          service: "{{ s.nom }}"
          lien: "{{ s.lien }}"
          hors_build: "{{ 'oui' if s.hors_build | default(false) else 'non' }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: mon-blackbox:9115

{% set plateforme_web = (plateforme_catalogue | default([])) | selectattr('url') | list %}
{% if plateforme_web %}
  # Adresse web de chaque application de la plateforme (applications/<nom>/) : alerte ApplicationHorsLigne,
  # variables web_ok et web_ms du modèle IA de l'application
  - job_name: applications
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
{% for a in plateforme_web %}
      - targets: ["{{ a.url }}"]
        labels:
          application: "{{ a.nom }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: mon-blackbox:9115

{% endif %}
  # Services découverts automatiquement (fichier tenu à jour par l'agent, relu par Prometheus sans redémarrage)
  - job_name: services-decouverts
    metrics_path: /probe
    file_sd_configs:
      - files: [/etc/prometheus/decouverte/*.json]
        refresh_interval: 1m
    relabel_configs:
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: mon-blackbox:9115

{% for job, port, only_app in [("node-exporter", port_node_exporter, false), ("cadvisor", port_cadvisor, false), ("cadvisor-k3s", port_cadvisor_k3s, true)] %}
  - job_name: {{ job }}
    static_configs:
{% for host in groups['all'] if (not only_app) or (hostvars[host].node_app | bool) %}
      - targets: ["{{ 'host.docker.internal' if host in groups['monitoring'] else hostvars[host].ansible_host }}:{{ port }}"]
        labels:
          node: {{ hostvars[host].node_name }}
{% endfor %}

{% endfor %}
